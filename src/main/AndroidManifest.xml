<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="de.smartrepair.gtvescbridge" />
        <package android:name="de.smartrepair.gtvescbridgx" />
    </queries>
    <application android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/patcher_icon"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <provider android:name=".CloneApkProvider"
            android:authorities="com.gtbridge.neonpatcher.apk"
            android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".PatcherActivity" android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
